# 服务端口
PORT=3001

# 可选：宿主机映射端口（公网访问端口）
# 示例：43001，容器内仍监听 3001
PUBLIC_PORT=43001

# 可选：限制 Node.js 堆内存（MB）
# 小内存机器建议 96~192；过小会导致 OOM，过大会增加宿主机压力
NODE_OPTIONS=--max-old-space-size=128

# 可选：容器内存上限（由 docker-compose.yml 使用）
# 例如：192m / 256m / 384m
CONTAINER_MEM_LIMIT=256m

# 可选：代理接口鉴权（建议公网必配）
# 客户端请求头可使用：X-API-Key 或 Authorization: Bearer <token>
BACKUP_API_KEY=

# 可选：允许的前端来源（逗号分隔）
# 例如：https://snapkeep.vercel.app,https://snapkeep.example.com
ALLOWED_ORIGINS=

# 可选：允许连接的 WebDAV 主机（逗号分隔）
# 支持精确匹配和通配符 *.example.com
# 例如：dav.jianguoyun.com,dav.aliyundrive.com,*.mydav.example.com
ALLOWED_WEBDAV_HOSTS=

# 可选：JSON 接口最大请求体（字节）
JSON_BODY_MAX_BYTES=1048576

# 可选：上传接口最大请求体（字节）
UPLOAD_BODY_MAX_BYTES=8388608

# 可选：单 IP 限流窗口（毫秒）
RATE_LIMIT_WINDOW_MS=60000

# 可选：单 IP 在窗口内最大请求数
RATE_LIMIT_MAX_REQUESTS=120

# 可选：访问 WebDAV 的单次请求超时（毫秒）
WEBDAV_TIMEOUT_MS=15000
